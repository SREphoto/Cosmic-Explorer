rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Player Saved Game Data
    match /saves/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // 1v1 Multiplayer Rooms (Battle & Race)
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Global & Daily Leaderboard Entries
    match /leaderboards/{entryId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    match /daily_leaderboards/{dateKey}/entries/{entryId} {
      allow read: if true;
      allow create, update: if request.auth != null;
    }

    // Home Planet Base & Sanctuary Saves
    match /home_planets/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
